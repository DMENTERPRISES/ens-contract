{
    // owner: danishahmedkm (danishahmed0123200@gmail.com)
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Node.js",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/index.js",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "name": "Attach to Node.js",
            "type": "node",
            "request": "attach",
            "port": 9229,
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "name": "Debug Hardhat",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/.bin/hardhat",
            "args": ["run", "scripts/deploy.ts"],
            "skipFiles": ["<node_internals>/**"]
        }
    ]
}